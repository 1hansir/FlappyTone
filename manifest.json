{
    "manifest_version": 3,
    "name": "Your Game Name",
    "version": "1.0.0",
    "description": "Description of your game",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [{
        "resources": ["index.html"],
        "matches": ["<all_urls>"]
    }]
} 