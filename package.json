{
  "name": "flappytone",
  "version": "1.0.0",
  "description": "A musical Flappy Bird game",
  "main": "electron.js",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "watch": "webpack --config webpack.config.js --mode development --watch",
    "start": "NODE_ENV=development electron .",
    "test:stream": "NODE_ENV=development TEST_STREAM=true electron .",
    "start:test": "NODE_ENV=development TEST_MIC=true electron .",
    "start-prod": "npm run build && electron .",
    "start-prod:test": "npm run build && TEST_MIC=true electron .",
    "package": "electron-builder"
  },
  "build": {
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "appId": "com.flappytone.game",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.games",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FlappyTone needs microphone access to detect pitch for gameplay.",
        "NSCameraUsageDescription": "FlappyTone does not use the camera.",
        "NSCameraUseContinuityCameraDeviceType": true
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons/icon.png"
    }
  },
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@types/chrome": "^0.0.254",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
